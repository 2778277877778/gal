################################################################################
## T1 九月「见」—— 第一幕，按《剧本_周墨线_第一幕_开学.md》v2（钢琴线）拆
##
## 五场固定戏 + 教学段自由行动；Flag 只在本幕拿 met_zhoumo / offered_candy。
## 三个选项都只改 T2 的一句台词，用 t1_answer / t1_candy / t1_night 三个变量记住。
## 背景全是纯色占位，美术给出 images/bg_*.png 后替换掉。
################################################################################

## 背景图统一在 game/story/defs/images.rpy 定义，这里只用 scene bg xxx。

## 本幕的选项记忆（T2 起读这三行决定台词变体）
default t1_answer = ""      # deny / ask / fumble
default t1_candy  = ""      # hand / step / via_zzb
default t1_night  = ""      # look / listen


label t1_september:

    $ start_month(1)

    ## 场景 1-1 · 报到（9/1，雨）
    scene bg school_gate_rain
    "九月的深圳还在下雨。校门口一排榕树，树根把人行道拱起一块一块，积水就积在那些坑里。"
    "蓝白校服堆在领物处的雨棚下面，一摞一摞，塑料膜上全是水珠。保安在喊「往前开往前开」。"
    inner "（这地方比三中大三倍。三中的教学楼走到底只有四层。）"

    scene bg dorm_402
    "六人间。上铺的箱子堆到天花板，下铺的凉席还没铺平。"
    "靠窗那张床上，一个人正用衣架去够掉在床底的泡面。衣架太软，弯了两次，第三次终于勾出来。"
    zzb "兄弟，你来得正好，帮我踩一下这个角。"
    mc "……踩哪。"
    zzb "随便，别踩泡面。"
    "我踩住了凉席的角。他把泡面拖出来，包装上全是灰，拍了拍就撕开了。"
    zzb "我叫周子博，三班的。你呢？"
    mc "XXX。"
    zzb "三中那个？"
    mc "……你怎么知道。"
    zzb "名单上有啊，三中考进来的就你一个。"
    zzb "兄弟，运气挺好啊。"
    inner "（运气好。这句话我听了整个暑假。）"

    scene bg classroom_morning
    "教室在二楼东头。报完到，按座位表坐下——最后一排靠窗。"
    zzb "这儿这儿，我给你占的。"
    "班主任抱着一摞书进来，说话前先把手表摘下来放在讲台上。"
    zeng "我姓曾，教语文，三年都是你们班主任。现在发书。"
    "发到一半，曾老师停下来，拎起一本作业本翻了两页。"
    zeng "周子博。"
    zzb "到。"
    zeng "这字还在渗墨。昨天写的吧。"
    "全班笑。周子博挠头，也笑。"
    zeng "开学第一天就这样，往后还有三年。"
    bro "——高一新生分班名单，现予公布。高一（一）班……"
    "没人真的在听。"
    bro "……高一（三）班，周墨。"
    "教室里安静了半秒。"
    zzb "她中考全市第一。"
    inner "（……所以呢。）"

    ## 场景 1-2 · 开学典礼（9/1，上午）
    scene bg playground_sun
    "雨停了。操场上的水还没干，站队的时候鞋底一直在打滑。"
    "新生代表上台。教导主任念她的名字，念到第二个字的时候，台下有一片很小的骚动。"
    zm "各位老师，各位同学。我是高一（三）班的周墨。"
    "她说话不快，也不看稿子。风把话筒吹得有一点杂音，她停下来，等杂音过去，再接着说。"
    zm "三年很长。我不想在第一天就把话说满。就这样，谢谢。"
    "台下愣了一秒，然后开始鼓掌。鼓得不算整齐，但比稿子上那些话受用。"
    "她下台，走过走廊的时候，手在抖。"
    "一张折成四折的纸从她手里掉了出来，落在地上，她没察觉。"
    inner "（……掉了。）"
    "我捡起来追上去。纸是手抄的，五线谱，一格一格画得很正。"
    "纸的右上角有一行铅笔小字：「别让他看见」。"
    mc "同、同学——你掉的东西。"
    "她转过身，看了一眼我手上的纸。那一瞬间她脸上的东西收得很快。"
    zm "……谢谢。"
    "她把纸接过去，折好，放进校服口袋。走了两步，又回头。"
    zm "你看见上面写的字了吗。"

    menu:
        "「没看见。」":
            $ t1_answer = "deny"
            mc "没看见。"
            "说得很干脆。"
            inner "（其实看见了。）"

        "「看见了。'别让他看见'，是什么意思？」":
            $ t1_answer = "ask"
            mc "看见了。'别让他看见'，是什么意思？"
            "问完我就知道问错了。脸发热。"
            zm "……没什么。"

        "「我、我什么都没看见，我就是……还给你。」":
            $ t1_answer = "fumble"
            mc "我、我什么都没看见，我就是……还给你。"
            "越说越乱，最后干脆不说了。"
            zm "……嗯。"

    $ set_flag("met_zhoumo")

    ## 场景 1-3 · 军训（9/2–9/7）
    scene bg playground_heat
    "第二周开始军训。九月的太阳直直地压下来，操场的水泥地反光，看久了眼睛疼。"
    "第三天下午，队伍休息。她从队列里出来，扶着栏杆站了一会儿，脸色白得不太对。"
    "我掏了掏口袋，摸到一颗糖——早上从小卖部顺手拿的。"
    mc "你、你要不要——"
    "手一滑，糖掉在地上，滚了半圈，停在排水口边上。"
    "我捡起来，吹了吹。"
    mc "还能吃。"
    zm "……"
    "她没接。我把糖塞回口袋，转身跑向小卖部。"
    "来回四百米。我跑回来的时候，气还没顺。"

    menu:
        "直接塞到她手里，转身就走":
            $ t1_candy = "hand"
            "我把新买的那颗塞到她手里，转头就走。走了两步，又回头。"
            mc "那个……多喝热水。"
            zm "……现在是九月。"
            "她说完，把糖放进校服口袋，跟那张谱子放在一起。"

        "放在她旁边的台阶上，不说话":
            $ t1_candy = "step"
            "我把糖放在她旁边的台阶上，没说话，走开了。"
            "她低头看了一眼，没拿。走的时候也没拿。"

        "让周子博转交":
            $ t1_candy = "via_zzb"
            zzb "我送？行啊。"
            "他笑嘻嘻地送过去，说了句「他给的」，全班都听见了。"
            zm "……"

    # 三个分支她都看见了糖，「给过糖」这个事实成立，都置位；
    # 具体怎么给的留在 t1_candy，T4 挑台词只读它。
    $ set_flag("offered_candy")

    stu_a "学委，来一个呗！"
    stu_b "听说你钢琴十级。"
    "她拧开水壶，喝了一口，把盖子拧回去。"
    zm "不会。"
    "起哄的人还要再说，教官吹了哨。"

    ## 场景 1-4 · 班委（9/8，周一）
    scene bg classroom_day
    "军训结束，正式上课。班委选举在班会课上做，念名字，举手。"
    zeng "学习委员，周墨。有意见吗。"
    "没人有意见。"
    "她站起来，鞠了一下躬，坐下，把桌上的作业本摞齐。"
    zeng "暑假作业还差几本，学委收一下。"
    "她一排一排收过来。走到我这儿，我翻了半天书包，少一本。"
    mc "我……好像少一本。"
    zm "几号。"
    mc "……三十二。"
    "她记下，笔没停，走到下一排去了。"
    "下课铃响，她抱着本子往办公室走。路过我桌子，停了一下。"
    zm "补完放讲台左边。第三摞。"
    mc "……你怎么知道我补得完。"
    zm "补不完也没关系。"
    "她走了。"

    ## 场景 1-5 · 晚自习后（9/8，21:40）
    scene bg corridor_night
    "晚自习九点四十结束。我回宿舍走到一半，想起来作业本还放在教室。"
    "回教室的路上要经过艺术楼。"
    "有人在弹琴。"
    "同一个乐句，弹到一半停住，重来，再停住。第三遍才顺下来。"
    "艺术楼四楼的走廊尽头，有一间屋子的门缝漏着光。"
    inner "（这么晚了，谁在弹。）"

    menu:
        "上去看":
            $ t1_night = "look"
            "走到三楼，琴声停了。走廊里只有一盏灯亮着。"
            "我站了一会儿，下楼。"

        "在楼下听完":
            $ t1_night = "listen"
            "我靠着楼梯扶手，听完第三遍，回宿舍。"

    ## T1 自由行动（教学段）
    call t1_free_actions

    ## 【第一幕结算】
    scene bg dorm_402
    "九月过完。学习 [study]，压力 [stress]，体力 [stamina]，钱 [money]。"
    "作业本补上了。谱子的事、糖的事，都没再提。"

    jump t2_october


################################################################################
## 教学段：3 点行动点、4 个地点、一定漏掉一个。
## 不用旁白解释「你选不完」，让玩家自己撞上。
################################################################################

label t1_free_actions:

    "（本月有 [ap] 点行动点，用掉就进月末。）"

    while ap > 0:

        menu:
            "去教室上课":
                $ do_action("attend_class")
                "周墨坐在第一排。我从前门进去，她没抬头。"

            "去图书馆自习":
                $ do_action("study")
                "还书车上堆着书，有人一本一本翻。"

            "去操场跑操":
                $ do_action("do_sport")
                zzb "打球去啊？"
                "我被他拉去打了半场。"

            "去食堂吃饭":
                $ do_action("eat_canteen")
                "一个人吃饭。吃一顿能顶一会儿。"

    "（行动点用完了，这个月就这样。）"
    return
